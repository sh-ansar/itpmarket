# Local PowerShell reference only. Spyon does not automatically load this file.
# Set these variables in the current shell or use START.bat.
ITP_ENV=local
ITP_HOST=127.0.0.1
ITP_PORT=8765
ITP_OPEN_BROWSER=0
ITP_STORAGE_BACKEND=sqlite
ITP_DISABLE_SCHEDULER=1
ITP_COOKIE_SECURE=0
ITP_TRUST_PROXY=0
ITP_TRUSTED_HOSTS=127.0.0.1,localhost
PLAYWRIGHT_BROWSERS_PATH=.playwright

# Telegram is opt-in. Keep the real token only in an ignored runtime env file.
ITP_TELEGRAM_BOT_ENABLED=0
# ITP_TELEGRAM_BOT_TOKEN=CHANGE_ME
# ITP_TELEGRAM_BOT_USERNAME=your_bot_username
# SPYON_PUBLIC_URL=https://spyon.kz

# Optional machine-specific browser paths. Do not commit profiles or cookies.
# OZON_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROMEDRIVER_PATH=C:\tools\chromedriver.exe

# PostgreSQL development is opt-in. Never put a real URL in this tracked file.
# ITP_STORAGE_BACKEND=postgresql
# DATABASE_URL=postgresql://spyon:CHANGE_ME@127.0.0.1:55433/spyon_dev
