# Copy is created at .runtime/production.env by install-production.ps1.
# Never commit the real file.
ITP_ENV=production
ITP_HOST=127.0.0.1
ITP_PORT=8765
ITP_OPEN_BROWSER=0
ITP_STORAGE_BACKEND=postgresql
DATABASE_URL=postgresql://spyon:CHANGE_ME@127.0.0.1:55433/spyon
ITP_SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ITP_COOKIE_SECURE=1
ITP_TRUST_PROXY=1
ITP_TRUSTED_HOSTS=spyon.kz,www.spyon.kz,127.0.0.1,localhost
ITP_DISABLE_SCHEDULER=0
SPYON_DOMAIN=spyon.kz
SPYON_PUBLIC_URL=https://spyon.kz
ITP_TELEGRAM_BOT_ENABLED=0
# ITP_TELEGRAM_BOT_TOKEN=CHANGE_ME
# ITP_TELEGRAM_BOT_USERNAME=your_bot_username
# Optional when Chrome is not installed machine-wide:
# OZON_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Transactional email
ITP_EMAIL_ENABLED=0
# ITP_SMTP_HOST=mail.example.com
# ITP_SMTP_PORT=587
# ITP_SMTP_USERNAME=spyon@example.com
# ITP_SMTP_PASSWORD=CHANGE_ME
ITP_SMTP_SECURITY=starttls
ITP_SMTP_REQUIRE_TLS=1
# ITP_MAIL_FROM=spyon@example.com
ITP_MAIL_FROM_NAME=Spyon
# ITP_MAIL_REPLY_TO=spyon@example.com
ITP_SMTP_TIMEOUT_SECONDS=20
ITP_EMAIL_MAX_ATTEMPTS=5
ITP_EMAIL_WORKER_INTERVAL=5
