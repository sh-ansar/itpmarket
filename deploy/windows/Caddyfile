{
	admin 127.0.0.1:2019
}

{$SPYON_DOMAIN:spyon.kz} {
	encode zstd gzip

	reverse_proxy 127.0.0.1:{$ITP_PORT:8765} {
		health_uri /ready
		health_interval 30s
		health_timeout 5s
		lb_try_duration 5s
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}

	log {
		output file .runtime/logs/caddy-access.log {
			roll_size 25MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

www.{$SPYON_DOMAIN:spyon.kz} {
	redir https://{$SPYON_DOMAIN:spyon.kz}{uri} permanent
}
